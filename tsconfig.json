{
  "compilerOptions": {
    "lib": ["DOM", "ES2024"],
    "module": "node20",
    "moduleResolution": "nodenext",
    "removeComments": false,
    "sourceMap": true,
    "target": "ES2024",
    "outDir": "./dist",
    "rootDir": "./src",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "declaration": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules/**/*", ".webpack/**/*", "_warmup/**/*", ".vscode/**/*", "vitest.config.mts", "debug/**/*"]
}
