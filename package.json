{
  "name": "n8nlift",
  "description": "Write n8n workflows in TypeScript, test them, and lift them from dev to prod. Code is the source. n8n is the runtime.",
  "author": "laurentvandelle",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "n8nlift": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#src/*": "./dist/*.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "npm run build && npm run start:prod",
    "start:prod": "cd debug && npm run start",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config src --fix",
    "lint:check": "eslint --flag unstable_native_nodejs_ts_config src",
    "test": "vitest run",
    "test:watch": "vitest",
    "pub": "npm version patch && npm publish",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint:check && npm run typecheck && npm test",
    "prepublishOnly": "npm run verify && npm run build",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "~1.3.26",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laurentvandelle/n8nlift.git"
  },
  "bugs": {
    "url": "https://github.com/laurentvandelle/n8nlift/issues"
  },
  "homepage": "https://github.com/laurentvandelle/n8nlift#readme",
  "keywords": [
    "n8n",
    "cli",
    "workflow-as-code",
    "typescript"
  ],
  "engines": {
    "node": ">=24"
  }
}
